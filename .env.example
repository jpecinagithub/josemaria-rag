# Copiar a .env en el despliegue. NUNCA versionar el .env real.
# PostgreSQL propio del proyecto (contenedor pgvector)
POSTGRES_DB=josemaria_rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=cambiar-por-una-clave-larga

# Token para los endpoints /api/admin/* (cabecera x-admin-token)
ADMIN_TOKEN=cambiar-por-un-token-largo

# LLM (Groq, API compatible con OpenAI). Sin clave, el backend arranca,
# /api/health responde y /api/chat degrada a modo «solo recuperación»
# con un mensaje claro de generación no configurada.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Embeddings locales (Ollama del host, contenedor rag-ollama).
# rag-ollama solo publica en el 127.0.0.1 del host y Docker no permite unir
# un servicio de compose a su red bridge por defecto; el servicio
# ollama-bridge del compose escucha en la pasarela de la red del proyecto
# (172.30.77.1:11434) y reenvía a ese 127.0.0.1:11434.
OLLAMA_BASE_URL=http://172.30.77.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMS=1024

# Umbral mínimo de similitud coseno para considerar que hay evidencia
RETRIEVAL_MIN_SCORE=0.55
